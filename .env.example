# Pexels API Key
PEXELS_API_KEY=
NEXT_PUBLIC_PEXELS_API_KEY=

# Sanity CMS Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Server-Side Write Token (for form submissions -> Sanity, NEVER exposed to client)
SANITY_API_WRITE_TOKEN=

# Production Public Site URL (for Open Graph and WhatsApp link previews)
NEXT_PUBLIC_SITE_URL=https://jobs.trax.ng
